{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasmtex-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "STORAGE_PREFIX",
      "bucket_name": "wasmtex"
    },
    {
      "binding": "MY_BUCKET",
      "bucket_name": "wasmtex"
    },
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "wasmtex"
    }
  ]
}
